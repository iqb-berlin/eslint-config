{
  "name": "@iqb/eslint-config",
  "version": "3.0.0",
  "description": "ESLint rules for javascript and typescript development",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./javascript": "./javascript.js",
    "./compat": "./compat.js"
  },
  "files": [
    "index.js",
    "javascript.js",
    "compat.js",
    "compat-rules.js",
    "docs",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "mocha \"tests/**/*.spec.js\"",
    "generate:compat": "node scripts/generate-compat-rules.js",
    "capture:legacy": "node scripts/capture-legacy-rules.js",
    "test:package": "node scripts/test-package.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iqb-berlin/eslint-config.git"
  },
  "keywords": [
    "eslint",
    "eslintconfig"
  ],
  "author": "Richard Henck",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/iqb-berlin/eslint-config/issues"
  },
  "homepage": "https://github.com/iqb-berlin/eslint-config#readme",
  "peerDependencies": {
    "eslint": "^9.0.0 || ^10.0.0",
    "@eslint/js": "^9.0.0 || ^10.0.0",
    "typescript": ">=4.8.4 <6.1.0"
  },
  "dependencies": {
    "typescript-eslint": "^8.70.1",
    "globals": "^15.0.0",
    "eslint-plugin-sonarjs": "^4.0.3",
    "eslint-plugin-jsdoc": "^62.9.0",
    "eslint-plugin-perfectionist": "^5.9.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-import-resolver-node": "^0.3.9",
    "eslint-import-resolver-typescript": "^4.4.5"
  },
  "devDependencies": {
    "mocha": "^11.7.4",
    "eslint": "^10.11.0",
    "@eslint/js": "^10.0.1",
    "typescript": "5.9.3"
  }
}
